{
  "name": "eslint-config-pdc",
  "version": "1.0.0",
  "description": "ESLint config for TypeScript",
  "main": "eslint.config.cjs",
  "type": "module",
  "scripts": {
    "deps:check": "ncu",
    "deps:update": "ncu -u",
    "format": "eslint --fix . && prettier --write \"./**/*.{cjs,js,json,md,ts}\"",
    "lint": "eslint . && prettier --check \"./**/*.{cjs,js,json,md,ts}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phonedotcom/eslint-config-pdc.git"
  },
  "author": "Juliusz Gonera",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phonedotcom/eslint-config-pdc/issues"
  },
  "homepage": "https://github.com/phonedotcom/eslint-config-pdc#readme",
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint-config-love": "^133.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "npm-check-updates": "^19.1.2",
    "prettier": "^3.6.2",
    "prettier-config-pdc": "github:phonedotcom/prettier-config-pdc#main"
  },
  "prettier": "prettier-config-pdc"
}
